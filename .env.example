# Docgrity — local development configuration.
# Copy to .env and fill in. NEVER commit .env.

# Database
DATABASE_URL=postgresql+asyncpg://docgrity:docgrity@localhost:5432/docgrity

# Redis (arq worker queue / cache)
REDIS_URL=redis://localhost:6379/0

# LLM providers — set the ones your routes use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GitHub Models: a GitHub PAT with the "models" scope (https://models.github.ai)
GITHUB_TOKEN=
# Local/self-hosted OpenAI-compatible endpoints
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=

# Capability → "provider:model" routing. Providers: openai | anthropic | github
# | ollama | custom, or any provider PydanticAI infers (google-gla, groq, ...).
# Examples: github:openai/gpt-4o-mini, ollama:llama3.1, groq:llama-3.3-70b
LLM_REASONING_HIGH_MODEL=anthropic:claude-sonnet-4-20250514
LLM_REASONING_FAST_MODEL=openai:gpt-4o-mini
LLM_CLASSIFICATION_MODEL=openai:gpt-4o-mini
LLM_EMBEDDING_MODEL=openai:text-embedding-3-small
# Optional automatic fallback when the primary provider errors (e.g. ollama:llama3.1:8b)
LLM_FALLBACK_MODEL=

# Confluence Cloud (development: API token auth)
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Jira connector (optional; defaults to the Confluence site + credentials)
JIRA_BASE_URL=

# GitHub connector (optional; repo read access for code-to-doc drift checks)
GITHUB_CONNECTOR_TOKEN=
# Comma-separated allow-list of repos, e.g. acme/api,acme/web (empty = any linked repo)
GITHUB_REPOS=

# Slack connector (optional; bot token with channels:read + channels:history)
SLACK_BOT_TOKEN=
# Comma-separated channel IDs to watch for undocumented decisions
SLACK_CHANNELS=

# API
API_SECRET_KEY=change-me
